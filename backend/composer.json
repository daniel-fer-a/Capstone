{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "cchia/admissions-backend",
    "type": "project",
    "description": "Base de postulaciones CCHIA para desarrollo local.",
    "license": "proprietary",
    "require": {
        "php": "~8.4.0",
        "ext-fileinfo": "*",
        "ext-pdo_pgsql": "*",
        "laravel/framework": "^13.17",
        "laravel/sanctum": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": false
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
