APP_NAME="CCHIA Postulaciones"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC
LOG_CHANNEL=single
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cchia_dev
DB_USERNAME=cchia_dev
DB_PASSWORD=
DB_SSLMODE=prefer
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=local
# Habilitar solo después de aprobar y configurar la política de revisión.
ADMISSIONS_REVIEW_ENABLED=false
# Los antecedentes del colaborador jurídico siguen pendientes de definición.
ADMISSIONS_COLLABORATOR_LEGAL_ENABLED=false
ADMISSIONS_MAX_FILE_KB=5120
ADMISSIONS_STORAGE_DRIVER=local
# Solo completar si se autoriza y configura el almacenamiento S3.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
ADMISSIONS_S3_PREFIX=admissions
